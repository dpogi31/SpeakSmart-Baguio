<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_background"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="24dp"
    android:paddingBottom="12dp">

    <!-- DICTIONARY HEADER -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DICTIONARY"
        android:textColor="@color/accent_teal"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.18"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Find a Word"
        android:textColor="@color/text_light"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Explore English and Tagalog meanings in Ilokano."
        android:textColor="@color/hint_text"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="24dp" />

    <!-- SEARCH FIELD -->

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search for a word..."
        app:boxBackgroundMode="filled"
        app:boxBackgroundColor="@color/card_background"
        app:boxStrokeColor="@color/accent_teal"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="1dp"
        app:boxCornerRadiusTopStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusBottomEnd="16dp"
        app:startIconDrawable="@android:drawable/ic_menu_search"
        app:startIconTint="@color/accent_teal"
        app:hintTextColor="@color/hint_text"
        app:boxStrokeErrorColor="@color/accent_teal">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:textColor="@color/text_light"
            android:textColorHint="@color/hint_text"
            android:textSize="16sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- LANGUAGE SELECTOR -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TRANSLATION LANGUAGE"
        android:textColor="@color/hint_text"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.10"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/languageDropdownLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxBackgroundMode="filled"
        app:boxBackgroundColor="@color/card_background"
        app:boxStrokeColor="@color/accent_teal"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="1dp"
        app:boxCornerRadiusTopStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusBottomEnd="16dp"
        app:hintEnabled="false"
        app:endIconMode="dropdown_menu"
        app:endIconTint="@color/accent_teal">

        <AutoCompleteTextView
            android:id="@+id/languageDropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="54dp"
            android:background="@android:color/transparent"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:hint="Select Target Language"
            android:textColor="@color/text_light"
            android:textColorHint="@color/hint_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:inputType="none"
            android:focusable="false"
            android:clickable="true" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- RESULTS SECTION HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Dictionary Results"
            android:textColor="@color/text_light"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="34dp"
            android:layout_height="3dp"
            android:background="@color/primary_teal" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Search to discover word meanings and pronunciations."
        android:textColor="@color/hint_text"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="8dp" />

    <!-- LOADING INDICATOR -->

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyle"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:layout_marginTop="12dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/accent_teal"
        android:visibility="gone" />

    <!-- EMPTY RESULTS MESSAGE -->

    <TextView
        android:id="@+id/textViewEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:text="No words found"
        android:textColor="@color/hint_text"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- DICTIONARY WORD LIST
         Existing ID and weighted scrolling preserved. -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewDictionary"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="16dp"
        android:scrollbars="vertical"
        android:overScrollMode="ifContentScrolls" />

</LinearLayout>
