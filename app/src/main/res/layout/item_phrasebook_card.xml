<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/primary_element"
    app:strokeWidth="1dp"
    app:rippleColor="#3357CFC3"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="8dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <!-- PHRASE INFORMATION -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textViewIlokano"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_teal"
                android:textSize="20sp"
                android:textStyle="bold"
                android:lineSpacingExtra="3dp"
                android:maxLines="3"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/textViewPartOfSpeech"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:textColor="@color/hint_text"
                android:textSize="12sp"
                android:textStyle="italic"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textViewSelectedTranslation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/text_light"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"
                android:maxLines="4"
                android:ellipsize="end" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Tap to view phrase details"
                android:textColor="@color/hint_text"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- FAVORITES BUTTON -->

        <TextView
            android:id="@+id/buttonFavorite"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="2dp"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:text="♡"
            android:textColor="@color/accent_teal"
            android:textSize="30sp"
            android:contentDescription="Add phrase to Favorites"
            android:importantForAccessibility="yes" />

        <!-- PRONUNCIATION BUTTON -->

        <ImageButton
            android:id="@+id/buttonPlayAudio"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:padding="12dp"
            android:background="@drawable/bg_speaker_button"
            android:contentDescription="Play phrase pronunciation"
            android:src="@drawable/ic_sound"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@null"
            app:tint="@color/accent_teal" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
