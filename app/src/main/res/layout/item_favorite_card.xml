<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/primary_element"
    app:strokeWidth="1dp"
    app:rippleColor="#3357CFC3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="12dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <!-- SAVED WORD OR PHRASE -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- ITEM TYPE -->

            <TextView
                android:id="@+id/textFavoriteType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/bg_favorite_type"
                android:text="DICTIONARY"
                android:textColor="@color/accent_teal"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <!-- ILOKANO TEXT -->

            <TextView
                android:id="@+id/textFavoriteIlokano"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/accent_teal"
                android:textSize="20sp"
                android:textStyle="bold"
                android:lineSpacingExtra="3dp"
                android:maxLines="4"
                android:ellipsize="end" />

            <!-- ENGLISH TRANSLATION -->

            <TextView
                android:id="@+id/textFavoriteEnglish"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_light"
                android:textSize="15sp"
                android:lineSpacingExtra="3dp" />

            <!-- TAGALOG TRANSLATION -->

            <TextView
                android:id="@+id/textFavoriteTagalog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/hint_text"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>

        <!-- REMOVE FAVORITE BUTTON -->

        <TextView
            android:id="@+id/buttonRemoveFavorite"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:text="♥"
            android:textColor="@color/accent_teal"
            android:textSize="26sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Remove this item from Favorites"
            android:importantForAccessibility="yes" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
