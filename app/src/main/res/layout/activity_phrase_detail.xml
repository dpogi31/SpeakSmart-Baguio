<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <!-- ============================================= -->
        <!-- TOP BAR -->
        <!-- ============================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SPEAK SMART BAGUIO"
                    android:textColor="@color/accent_teal"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Phrase Details"
                    android:textColor="@color/light_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_speaker_button"
                android:contentDescription="Go back"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                app:tint="@color/accent_teal" />

        </LinearLayout>

        <!-- ============================================= -->
        <!-- MAIN ILOKANO PHRASE CARD -->
        <!-- ============================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/primary_teal"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ILOKANO PHRASE"
                    android:textColor="@color/accent_teal"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <TextView
                    android:id="@+id/tvIlokano"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textColor="@color/accent_teal"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="5dp"
                    android:breakStrategy="high_quality"
                    android:hyphenationFrequency="none"
                    android:textIsSelectable="true" />

                <View
                    android:layout_width="48dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="18dp"
                    android:background="@color/primary_teal" />

                <TextView
                    android:id="@+id/tvPartOfSpeech"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/dropdown_glass_background"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:textColor="@color/accent_teal"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/dropdown_glass_background"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:textColor="@color/light_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================= -->
        <!-- TRANSLATIONS HEADING -->
        <!-- ============================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Translations"
            android:textColor="@color/light_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Understand the phrase in your preferred language."
            android:textColor="@color/hint_text"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <!-- ============================================= -->
        <!-- ENGLISH TRANSLATION CARD -->
        <!-- ============================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/primary_element"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ENGLISH"
                    android:textColor="@color/accent_teal"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <TextView
                    android:id="@+id/tvEnglish"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/light_text"
                    android:textSize="18sp"
                    android:lineSpacingExtra="5dp"
                    android:textIsSelectable="true" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================= -->
        <!-- TAGALOG TRANSLATION CARD -->
        <!-- ============================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/primary_element"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TAGALOG"
                    android:textColor="@color/accent_teal"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <TextView
                    android:id="@+id/tvTagalog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/light_text"
                    android:textSize="18sp"
                    android:lineSpacingExtra="5dp"
                    android:textIsSelectable="true" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================= -->
        <!-- EXAMPLE SENTENCES HEADING -->
        <!-- ============================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Example Sentences"
            android:textColor="@color/light_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="See how the phrase can be used in conversation."
            android:textColor="@color/hint_text"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <!-- ============================================= -->
        <!-- ILOKANO EXAMPLE SENTENCE -->
        <!-- ============================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/primary_element"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ILOKANO"
                    android:textColor="@color/accent_teal"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <TextView
                    android:id="@+id/tvSentence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/light_text"
                    android:textSize="17sp"
                    android:lineSpacingExtra="6dp"
                    android:textIsSelectable="true" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================= -->
        <!-- ENGLISH EXAMPLE TRANSLATION -->
        <!-- ============================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/primary_element"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ENGLISH TRANSLATION"
                    android:textColor="@color/accent_teal"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvEnglishSentence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/light_text"
                    android:textSize="17sp"
                    android:lineSpacingExtra="6dp"
                    android:textIsSelectable="true" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================= -->
        <!-- BOTTOM SPACING -->
        <!-- ============================================= -->


        <!-- MATCHING HOME SCREEN FOOTER -->
        <include
            layout="@layout/view_app_footer" />


    </LinearLayout>

</ScrollView>
