<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    tools:context=".SplashActivity">

    <!-- ==========================================
         APP LOGO
         Starts invisible for the entrance animation
         ========================================== -->

    <ImageView
        android:id="@+id/splashLogo"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="88dp"
        android:src="@drawable/ic_logo"
        android:scaleType="fitCenter"
        android:contentDescription="Speak Smart Baguio Logo"
        android:alpha="0"
        android:scaleX="0.8"
        android:scaleY="0.8" />

    <!-- ==========================================
         DEVELOPER CREDIT
         ========================================== -->

    <TextView
        android:id="@+id/textDeveloperCredit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/splashLogo"
        android:layout_marginTop="14dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:gravity="center"
        android:text="DEVELOPED BY BLUE PHENIX STUDENTS"
        android:textColor="@color/hint_text"
        android:textSize="11sp"
        android:textStyle="normal"
        android:fontFamily="sans"
        android:letterSpacing="0.08"
        android:includeFontPadding="false"
        android:alpha="0" />

    <!-- ==========================================
         ANIMATED GROUP TITLE
         Existing ID preserved
         ========================================== -->

    <LinearLayout
        android:id="@+id/letterContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_below="@id/textDeveloperCredit"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="22dp" />

    <!-- ==========================================
         TAGLINE
         Appears after the title animation finishes
         ========================================== -->

    <TextView
        android:id="@+id/textGroupSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/letterContainer"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center"
        android:text="LEARN  •  UNDERSTAND  •  CONNECT"
        android:textColor="@color/accent_teal"
        android:textSize="11sp"
        android:textStyle="normal"
        android:fontFamily="sans"
        android:letterSpacing="0.12"
        android:includeFontPadding="false"
        android:alpha="0" />

    <!-- ==========================================
         LOADING INDICATOR
         Fades in after the tagline
         ========================================== -->

    <com.github.ybq.android.spinkit.SpinKitView
        android:id="@+id/spinnerDots"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="80dp"
        android:visibility="visible"
        android:alpha="0"
        app:SpinKit_Color="@color/primary_teal" />

</RelativeLayout>
