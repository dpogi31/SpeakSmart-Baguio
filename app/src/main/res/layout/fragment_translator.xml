<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="vertical"
    tools:context=".TranslatorFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <!-- PAGE HEADER AND SETTINGS BUTTON -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/translatorPageHeading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TRANSLATOR"
                android:textColor="@color/accent_teal"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.16" />

            <ImageButton
                android:id="@+id/buttonSettingsMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_settings_teal"
                android:contentDescription="Open settings menu"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:clickable="true"
                android:focusable="true"
                android:importantForAccessibility="yes" />

        </LinearLayout>

        <!-- TRANSLATION TITLE -->

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="English → Ilokano"
            android:textColor="@color/text_light"
            android:textSize="25sp"
            android:textStyle="bold"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:id="@+id/translatorSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Translate words and discover their meaning."
            android:textColor="@color/light_gray"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp" />

        <!-- LANGUAGE SELECTION -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp"
            android:text="TRANSLATION MODE"
            android:textColor="@color/accent_teal"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/languageDropdownLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxBackgroundMode="filled"
            app:boxBackgroundColor="@color/card_background"
            app:boxStrokeColor="@color/primary_teal"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:hintEnabled="false"
            app:endIconMode="dropdown_menu"
            app:endIconTint="@color/accent_teal">

            <AutoCompleteTextView
                android:id="@+id/languageDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:background="@android:color/transparent"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp"
                android:fontFamily="sans"
                android:textColor="@color/text_light"
                android:textColorHint="@color/hint_text"
                android:textSize="16sp"
                android:textStyle="bold"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none"
                android:hint="Select Translation Mode"
                android:importantForAccessibility="yes" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- INPUT SECTION -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp"
            android:text="ENTER TEXT"
            android:textColor="@color/accent_teal"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="#6657CFC3"
            app:strokeWidth="1dp">

            <EditText
                android:id="@+id/editTextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="120dp"
                android:gravity="top|start"
                android:background="@android:color/transparent"
                android:padding="18dp"
                android:hint="Tap here and type a word or sentence..."
                android:inputType="textCapSentences|textMultiLine"
                android:imeOptions="flagNoExtractUi"
                android:textColor="@color/text_light"
                android:textColorHint="@color/hint_text"
                android:textSize="17sp"
                android:lineSpacingExtra="4dp"
                android:autofillHints="none" />

        </com.google.android.material.card.MaterialCardView>

        <!-- VOICE ACTIONS HEADING -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="VOICE TOOLS"
            android:textColor="@color/accent_teal"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <!-- VOICE ACTION BUTTONS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- MICROPHONE BUTTON -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    app:cardBackgroundColor="@color/accent_teal"
                    app:cardCornerRadius="38dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/micButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="22dp"
                        android:contentDescription="Start voice input"
                        android:clickable="true"
                        android:focusable="true"
                        android:src="@drawable/ic_mic"
                        app:tint="@color/text_dark" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Speak"
                    android:textColor="@color/text_light"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="Voice input"
                    android:textColor="@color/hint_text"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- LISTEN BUTTON -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    app:cardBackgroundColor="@color/primary_teal"
                    app:cardCornerRadius="38dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/ttsButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="22dp"
                        android:contentDescription="Play translated text"
                        android:clickable="true"
                        android:focusable="true"
                        android:src="@drawable/ic_sound"
                        app:tint="@color/text_dark" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Listen"
                    android:textColor="@color/text_light"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="Hear translation"
                    android:textColor="@color/hint_text"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- ORIGINAL TEXT CARD -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="#6657CFC3"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ORIGINAL TEXT"
                    android:textColor="@color/accent_teal"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10" />

                <TextView
                    android:id="@+id/originalText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:layout_marginTop="10dp"
                    android:text="Your original text will appear here."
                    android:textColor="#99E5F3F2"
                    android:textSize="16sp"
                    android:lineSpacingExtra="4dp"
                    android:textIsSelectable="true" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- TRANSLATED TEXT CARD -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/primary_teal"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TRANSLATED TEXT"
                    android:textColor="@color/accent_teal"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10" />

                <TextView
                    android:id="@+id/translatedText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="10dp"
                    android:text="Your translation will appear here."
                    android:textColor="#99E5F3F2"
                    android:textSize="16sp"
                    android:lineSpacingExtra="5dp"
                    android:textIsSelectable="true" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- HOME SCREEN FOOTER -->

        <include
            layout="@layout/view_app_footer" />

    </LinearLayout>

</ScrollView>
