<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="32dp">

        <!-- BACK BUTTON — MATCHES WORD DETAILS -->

        <ImageButton
            android:id="@+id/buttonAccessibilityBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Go back"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/accent_teal" />


        <!-- PAGE TITLE -->

        <TextView
            android:id="@+id/accessibilitySettingsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Accessibility Settings"
            android:textColor="@color/accent_teal"
            android:textSize="30sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="28dp"
            android:text="Make Speak Smart Baguio easier to read and use."
            android:textColor="@color/text_light"
            android:textSize="17sp"
            android:lineSpacingExtra="4dp" />

        <!-- TEXT SIZE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Text Size"
            android:textColor="@color/text_light"
            android:textSize="22sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            android:text="Choose the size that is most comfortable for you."
            android:textColor="@color/hint_text"
            android:textSize="15sp" />

        <RadioGroup
            android:id="@+id/fontSizeRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/fontSizeStandard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Standard"
                android:textColor="@color/text_light"
                android:textSize="18sp"
                android:buttonTint="@color/accent_teal" />

            <RadioButton
                android:id="@+id/fontSizeLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Large"
                android:textColor="@color/text_light"
                android:textSize="20sp"
                android:buttonTint="@color/accent_teal" />

            <RadioButton
                android:id="@+id/fontSizeExtraLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Extra Large"
                android:textColor="@color/text_light"
                android:textSize="22sp"
                android:buttonTint="@color/accent_teal" />

        </RadioGroup>

        <!-- HIGH CONTRAST -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:background="@color/primary_element"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="High Contrast"
            android:textColor="@color/text_light"
            android:textSize="22sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Use clearer text and stronger visual contrast."
            android:textColor="@color/hint_text"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchHighContrast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="56dp"
            android:text="Enable high contrast"
            android:textColor="@color/text_light"
            android:textSize="18sp"
            app:thumbTint="@color/accent_teal"
            app:trackTint="@color/primary_element" />

        <!-- SIMPLIFIED LAYOUT -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:background="@color/primary_element"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Simplified Layout"
            android:textColor="@color/text_light"
            android:textSize="22sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Reduce decorative elements to make important information easier to focus on."
            android:textColor="@color/hint_text"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchSimplifiedLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="56dp"
            android:text="Enable simplified layout"
            android:textColor="@color/text_light"
            android:textSize="18sp"
            app:thumbTint="@color/accent_teal"
            app:trackTint="@color/primary_element" />

        <!-- RESET -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonResetAccessibility"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:text="Reset to Default"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_light"
            android:backgroundTint="@color/card_background"
            android:contentDescription="Reset all accessibility settings to their default values"
            app:cornerRadius="12dp"
            app:strokeColor="@color/primary_element"
            app:strokeWidth="1dp" />

    </LinearLayout>

</ScrollView>
